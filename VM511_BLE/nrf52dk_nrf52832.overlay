&pinctrl {
    i2c0_newdefault: i2c0_newdefault {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 11)>,
                    <NRF_PSEL(TWIM_SCL, 0, 12)>;
        };
    };

    i2c0_newsleep: i2c0_newsleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 11)>,
                    <NRF_PSEL(TWIM_SCL, 0, 12)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&i2c0_newdefault>;       // ✅ moved here
    pinctrl-1 = <&i2c0_newsleep>;         // ✅ moved here
    pinctrl-names = "default", "sleep"; // ✅ required

    vm511: vm511@50 {
        compatible = "i2c-device";
        reg = <0x50>;
        // pinctrl does NOT go here
    };
};

